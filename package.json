{
  "name": "4less",
  "version": "2.0.0",
  "description": "A minimal DSL that compiles to HTML",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/plugins/vite.js",
      "types": "./dist/plugins/vite.d.ts"
    },
    "./webpack": {
      "import": "./dist/plugins/webpack.js",
      "types": "./dist/plugins/webpack.d.ts"
    },
    "./esbuild": {
      "import": "./dist/plugins/esbuild.js",
      "types": "./dist/plugins/esbuild.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "bin": {
    "4less": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "html",
    "dsl",
    "parser",
    "compiler",
    "template"
  ],
  "author": "dzhonragon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dzhonragon/4less.git"
  },
  "homepage": "https://github.com/dzhonragon/4less",
  "bugs": {
    "url": "https://github.com/dzhonragon/4less/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
