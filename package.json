{
  "name": "4less",
  "version": "2.0.0",
  "description": "A minimal DSL that compiles to HTML",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist/"],
  "bin": {
    "4less": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "html",
    "dsl",
    "parser",
    "compiler",
    "template"
  ],
  "author": "dzhonragon",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
