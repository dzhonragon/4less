{
  "name": "@dzhonragon/4less",
  "version": "2.1.1",
  "description": "Minimal DSL for HTML with variables, loops & conditionals. Zero dependencies. Compile to React, Vue, Astro, or plain HTML.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/plugins/vite.js",
      "types": "./dist/plugins/vite.d.ts"
    },
    "./webpack": {
      "import": "./dist/plugins/webpack.js",
      "types": "./dist/plugins/webpack.d.ts"
    },
    "./esbuild": {
      "import": "./dist/plugins/esbuild.js",
      "types": "./dist/plugins/esbuild.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "bin": {
    "4less": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "html",
    "dsl",
    "parser",
    "compiler",
    "template"
  ],
  "author": "dzhonragon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dzhonragon/4less.git"
  },
  "homepage": "https://github.com/dzhonragon/4less",
  "bugs": {
    "url": "https://github.com/dzhonragon/4less/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/add-shebang.mjs",
    "test": "vitest run",
    "bench": "vitest bench",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:preview": "npx serve docs -l 3000",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^20.0.0",
    "@types/pug": "^2.0.10",
    "ejs": "^5.0.2",
    "handlebars": "^4.7.9",
    "marked": "^18.0.3",
    "pug": "^3.0.4",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
