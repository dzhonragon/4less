nav class:"sticky top-0 z-50 h-12 flex items-center justify-between px-6 bg-zinc-950 border-b border-zinc-800" {
  a "4less" class:"font-mono font-bold text-zinc-100 tracking-tight" href:"../../"
  div class:"flex items-center gap-5 text-sm" {
    a "Syntax"     class:"text-zinc-400 hover:text-zinc-100 transition-colors" href:"../../#syntax"
    a "Playground" class:"text-zinc-400 hover:text-zinc-100 transition-colors" href:"../../#playground"
    a "Docs"       class:"text-zinc-100 font-medium" href:""
    a "GitHub"     class:"text-zinc-400 hover:text-zinc-100 transition-colors" href:"https://github.com/dzhonragon/4less" target:"_blank"
    a "npm"        class:"text-zinc-400 hover:text-zinc-100 transition-colors" href:"https://www.npmjs.com/package/@dzhonragon/4less" target:"_blank"
  }
}
div class:"max-w-5xl mx-auto px-6 pt-12 pb-16" {
  div class:"flex gap-10" {
    nav class:"w-52 shrink-0 pt-1" {
      p "Guide" class:"text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-3 px-3"
      ul class:"space-y-0.5 text-sm" {
        li { a "Getting Started"  class:"block px-3 py-1.5 rounded-lg text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" href:"getting-started/" }
        li { a "Syntax Reference" class:"block px-3 py-1.5 rounded-lg text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" href:"syntax/" }
        li { a "API Reference"    class:"block px-3 py-1.5 rounded-lg text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" href:"api-reference/" }
        li { a "CLI Reference"    class:"block px-3 py-1.5 rounded-lg text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" href:"cli/" }
        li { a "Integrations"     class:"block px-3 py-1.5 rounded-lg text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 transition-colors" href:"integrations/" }
      }
    }
    div class:"flex-1 min-w-0" {
      h1 "Documentation" class:"text-3xl font-bold text-white mb-2"
      p "Everything you need to use 4less effectively." class:"text-zinc-400 mb-8"
      div class:"grid grid-cols-2 gap-4" {
        a class:"block rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4 hover:border-zinc-600 transition-colors" href:"getting-started/" {
          p "Getting Started" class:"text-sm font-semibold text-white"
          p "Install 4less and write your first template in under five minutes." class:"mt-1 text-xs text-zinc-400"
        }
        a class:"block rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4 hover:border-zinc-600 transition-colors" href:"syntax/" {
          p "Syntax Reference" class:"text-sm font-semibold text-white"
          p "Complete reference for all language constructs and features." class:"mt-1 text-xs text-zinc-400"
        }
        a class:"block rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4 hover:border-zinc-600 transition-colors" href:"api-reference/" {
          p "API Reference" class:"text-sm font-semibold text-white"
          p "TypeScript API for compiling, parsing, and generating output." class:"mt-1 text-xs text-zinc-400"
        }
        a class:"block rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4 hover:border-zinc-600 transition-colors" href:"cli/" {
          p "CLI Reference" class:"text-sm font-semibold text-white"
          p "Command-line interface for compiling .4l files." class:"mt-1 text-xs text-zinc-400"
        }
        a class:"block rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4 hover:border-zinc-600 transition-colors" href:"integrations/" {
          p "Integrations" class:"text-sm font-semibold text-white"
          p "Use 4less with Vite, Webpack, and esbuild build tools." class:"mt-1 text-xs text-zinc-400"
        }
      }
    }
  }
}
footer class:"border-t border-zinc-800 py-8 text-center text-sm text-zinc-600" {
  p "4less is MIT licensed. Built by dzhonragon."
  div class:"mt-2 flex justify-center gap-4" {
    a "GitHub" class:"hover:text-zinc-400 transition-colors" href:"https://github.com/dzhonragon/4less" target:"_blank"
    a "npm"    class:"hover:text-zinc-400 transition-colors" href:"https://www.npmjs.com/package/@dzhonragon/4less" target:"_blank"
    a "Issues" class:"hover:text-zinc-400 transition-colors" href:"https://github.com/dzhonragon/4less/issues" target:"_blank"
  }
}
