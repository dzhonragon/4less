nav class:"sticky top-0 z-50 h-12 flex items-center justify-between px-4 sm:px-6 bg-zinc-950 border-b border-zinc-800" {
  a "4less" class:"font-mono font-bold text-zinc-100 tracking-tight" href:""
  div class:"flex items-center gap-3 sm:gap-5 text-sm" {
    a "Syntax"     class:"hidden md:block text-zinc-400 hover:text-zinc-100 transition-colors" href:"#syntax"
    a "Playground" class:"hidden md:block text-zinc-400 hover:text-zinc-100 transition-colors" href:"#playground"
    a "Docs"       class:"text-zinc-400 hover:text-zinc-100 transition-colors" href:"pages/guide/"
    a "GitHub"     class:"text-zinc-400 hover:text-zinc-100 transition-colors" href:"https://github.com/dzhonragon/4less" target:"_blank"
    a "npm"        class:"hidden sm:block text-zinc-400 hover:text-zinc-100 transition-colors" href:"https://www.npmjs.com/package/@dzhonragon/4less" target:"_blank"
  }
}
div class:"max-w-5xl mx-auto px-4 sm:px-6 pt-10 sm:pt-16 pb-8" {
  div class:"grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start" {
    div class:"flex flex-col justify-center" {
      h1 "4less" class:"text-5xl font-extrabold tracking-tighter text-white leading-none"
      p "A minimal DSL that compiles to HTML, React, Vue and Astro. Zero dependencies." class:"mt-3 text-lg text-zinc-400 leading-relaxed"
      div class:"mt-6 flex items-center gap-2" {
        div class:"flex items-center gap-2 bg-zinc-900 border border-zinc-700 rounded-lg px-3.5 py-2 font-mono text-sm text-zinc-300 min-w-0 overflow-hidden" {
          span "$" class:"text-zinc-600 select-none shrink-0"
          code "npm install @dzhonragon/4less" class:"truncate"
          button "copy" id:"copy-btn" class:"ml-2 text-xs text-zinc-500 border border-zinc-700 rounded px-1.5 py-0.5 transition-colors hover:text-zinc-300 shrink-0"
        }
      }
      div class:"mt-5 flex gap-3" {
        a "Playground"    class:"inline-flex items-center px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium transition-opacity hover:opacity-80" href:"#playground"
        a "Documentation" class:"inline-flex items-center px-4 py-2 rounded-lg bg-zinc-800 text-zinc-200 text-sm font-medium border border-zinc-700 transition-opacity hover:opacity-80" href:"pages/guide/"
      }
    }
    div class:"rounded-xl border border-zinc-800 bg-zinc-900 overflow-hidden" {
      div class:"flex items-center justify-between px-4 py-2 border-b border-zinc-800" {
        span "live preview" class:"text-xs text-zinc-500 font-mono"
        div class:"flex gap-1" {
          button "4less" id:"hero-tab-code" class:"text-xs font-mono px-2 py-0.5 rounded text-white bg-zinc-700"
          button "preview" id:"hero-tab-preview" class:"text-xs font-mono px-2 py-0.5 rounded text-zinc-400"
        }
      }
      div class:"relative" style:"height:220px" {
        textarea id:"hero-input" class:"absolute inset-0 w-full h-full bg-zinc-950 text-zinc-100 font-mono text-sm p-4 resize-none outline-none" spellcheck:"false"
        iframe id:"hero-preview" class:"absolute inset-0 w-full h-full border-0 bg-white hidden"
      }
    }
  }
  div class:"grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8" {
    div class:"rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4" {
      p "Zero deps" class:"text-xs font-semibold text-indigo-400 uppercase tracking-wider"
      p "No runtime dependencies. Lexer and parser are handwritten TypeScript." class:"mt-1 text-sm text-zinc-400"
    }
    div class:"rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4" {
      p "Multi-framework" class:"text-xs font-semibold text-indigo-400 uppercase tracking-wider"
      p "One source, five targets: HTML, React, Vue, Astro, JSON." class:"mt-1 text-sm text-zinc-400"
    }
    div class:"rounded-xl border border-zinc-800 bg-zinc-900 px-5 py-4" {
      p "Minimal syntax" class:"text-xs font-semibold text-indigo-400 uppercase tracking-wider"
      p "No closing tags. Dots for classes, hashes for IDs." class:"mt-1 text-sm text-zinc-400"
    }
  }
}
div id:"syntax" class:"max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-4" {
  p "Syntax" class:"text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-4"
  span id:"__syntax-showcase__"
}
div id:"playground" class:"max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-16" {
  p "Playground" class:"text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-4"
  div class:"rounded-xl border border-zinc-800 bg-zinc-900 overflow-hidden" {
    div class:"flex items-center justify-between px-4 py-2.5 border-b border-zinc-800 flex-wrap gap-2" {
      span "4less input" class:"text-sm font-medium text-zinc-400"
      div id:"format-tabs" class:"flex gap-1 flex-wrap" {
        button "HTML"    class:"tab-btn active text-xs font-mono px-2.5 py-1 rounded text-white bg-zinc-700" data-format:"html"
        button "React"   class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"react"
        button "Vue"     class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"vue"
        button "Astro"   class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"astro"
        button "Preview" class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"preview"
      }
    }
    div class:"grid grid-cols-1 sm:grid-cols-2" {
      textarea id:"editor-input" class:"bg-zinc-950 text-zinc-100 font-mono text-sm p-4 resize-none outline-none border-b sm:border-b-0 sm:border-r border-zinc-800 min-h-48 sm:min-h-64 w-full" spellcheck:"false"
      div id:"editor-right" class:"bg-zinc-950 min-h-48 sm:min-h-64 overflow-auto" {
        pre id:"editor-output" class:"text-emerald-400 font-mono text-sm p-4 whitespace-pre-wrap"
        iframe id:"editor-preview" class:"w-full h-48 sm:h-64 border-0 hidden"
      }
    }
    div class:"flex items-center gap-2 px-4 py-2 border-t border-zinc-800 bg-zinc-900 flex-wrap" {
      span "Examples:" class:"text-xs text-zinc-600"
      button "hello"     class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"hello"
      button "component" class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"card"
      button "loop"      class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"loop"
      button "form"      class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"form"
    }
  }
}
footer class:"border-t border-zinc-800 py-8 text-center text-sm text-zinc-600" {
  p "4less is MIT licensed. Built by dzhonragon."
  div class:"mt-2 flex justify-center gap-4" {
    a "GitHub" class:"hover:text-zinc-400 transition-colors" href:"https://github.com/dzhonragon/4less" target:"_blank"
    a "npm"    class:"hover:text-zinc-400 transition-colors" href:"https://www.npmjs.com/package/@dzhonragon/4less" target:"_blank"
    a "Issues" class:"hover:text-zinc-400 transition-colors" href:"https://github.com/dzhonragon/4less/issues" target:"_blank"
  }
}
