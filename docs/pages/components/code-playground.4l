div id:"playground" class:"max-w-5xl mx-auto px-6 pt-12 pb-16" {
  p "Playground" class:"text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-4"
  div class:"rounded-xl border border-zinc-800 bg-zinc-900 overflow-hidden" {
    div class:"flex items-center justify-between px-4 py-2.5 border-b border-zinc-800" {
      span "4less input" class:"text-sm font-medium text-zinc-400"
      div id:"format-tabs" class:"flex gap-1" {
        button "HTML"    class:"tab-btn active text-xs font-mono px-2.5 py-1 rounded text-white bg-zinc-700" data-format:"html"
        button "React"   class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"react"
        button "Vue"     class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"vue"
        button "Astro"   class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"astro"
        button "Preview" class:"tab-btn text-xs font-mono px-2.5 py-1 rounded text-zinc-400" data-format:"preview"
      }
    }
    div class:"grid grid-cols-2" {
      textarea id:"editor-input" class:"bg-zinc-950 text-zinc-100 font-mono text-sm p-4 resize-none outline-none border-r border-zinc-800 min-h-64 w-full" spellcheck:"false"
      div id:"editor-right" class:"bg-zinc-950 min-h-64 overflow-auto" {
        pre id:"editor-output" class:"text-emerald-400 font-mono text-sm p-4 whitespace-pre-wrap"
        iframe id:"editor-preview" class:"w-full h-64 border-0 hidden"
      }
    }
    div class:"flex items-center gap-2 px-4 py-2 border-t border-zinc-800 bg-zinc-900" {
      span "Examples:" class:"text-xs text-zinc-600"
      button "hello"     class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"hello"
      button "component" class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"card"
      button "loop"      class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"loop"
      button "form"      class:"example-btn text-xs text-zinc-500 border border-zinc-700 rounded px-2 py-0.5 font-mono transition-colors hover:text-zinc-200" data-example:"form"
    }
  }
}
